[sub_resource type="GDScript" id="GDScript_55kwv"]
resource_name = "MainMenuCamera"
script/source = "extends Camera3D

var myRotation = 0

func _process(delta: float) -> void:
	myRotation -= 0.05
	if myRotation > 360:
		myRotation = 0
	rotation = Vector3(deg_to_rad(-20), deg_to_rad(myRotation), 0)
"

[sub_resource type="GDScript" id="GDScript_8mikk"]
resource_name = "FPSCounter"
script/source = "extends Label

func _process(delta: float) -> void:
	text = \"FPS: %d\" % Engine.get_frames_per_second()
"

