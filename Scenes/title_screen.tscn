"

[sub_resource type="GDScript" id="GDScript_0xyb7"]
resource_name = "LevelSelector"
script/source = "extends Button

var levels: Array[Control]
var visibile = false

func _ready() -> void:
	for child in get_parent().get_children():
		if child != self and child is Control:
			levels.append(child)
	for setting in levels:
		setting.visible = false
	pressed.connect(_toggle_settings)

func _toggle_settings() -> void:
	for level in levels:
		level.visible = !level.visible
	visibile = !visibile
	self.text = \"Level Select\"
	if visibile == true:
		self.text = \"Level Select ▼\"
"

[sub_resource type="GDScript" id="GDScript_1pivh"]
resource_name = "Settings"
script/source = "extends Button

var settings: Array[Control]
var visibile = false

func _ready() -> void:
	for child in get_parent().get_children():
		if child != self and child is Control:
			settings.append(child)
	for setting in settings:
		setting.visible = false
	pressed.connect(_toggle_settings)

func _toggle_settings() -> void:
	for setting in settings:
		setting.visible = !setting.visible
	visibile = !visibile
	self.text = \"Settings\"
	if visibile == true:
		self.text = \"Settings ▼\"
"

