[sub_resource type="GDScript" id="GDScript_1pivh"]
resource_name = "Player"
script/source = "extends CharacterBody3D

enum states {GROUND, AIR, SLAM, DASH}
var current_state: states = states.GROUND

const WALK_SPEED = 18
const SPRINT_SPEED = 20.0
var speed = WALK_SPEED

var fall_velocity = 0.0
const JUMP_VELOCITY = 15.0
const PLAYER_GRAVITY = Vector3(0, -25.0, 0)
const MAX_FALL_SPEED = -25
const SENSITIVITY = 0.01
const AIR_CONTROL = 4.0 # Air control is measured in % per frame

const DASH_SPEED = 25
const DASH_DURATION = 0.15

var dash_timer = 0.0
var dash_direction = Vector3.ZERO

# Variable landing volume
const LANDING_SFX_MIN_VELOCITY = 5
const LANDING_SFX_MAX_VELOCITY = 20
const LANDING_SFX_MIN_VOLUME = -50
const LANDING_SFX_MAX_VOLUME = -25

# Head bobbing
const BOB_FREQ = 1.2
const BOB_AMP = 0.04
var t_bob = 0
var last_bob_x_position = 0.0
var last_bob_direction = 0
var head_bobbing_x_position = 0.0
var head_bobbing_y_position = 0.0

# Fov variables
const BASE_FOV = 80
const FOV_SPEED_BOOST = 1

@onready var head = $Head
@onready var camera = $Head/Camera3D
@onready var footsteps_sfx: AudioStreamPlayer3D = $Feet/Footsteps
@onready var jump_sfx: AudioStreamPlayer3D = $Feet/Jump
@onready var landing_sfx: AudioStreamPlayer3D = $Feet/Landing
@onready var dash_sfx: AudioStreamPlayer3D = $Feet/Dash
@onready var slam_sfx: AudioStreamPlayer3D = $Feet/Slam
@export var hit_sounds: Array[AudioStream] = []
@onready var hurt_sfx: AudioStreamPlayer3D = $HurtSFX
@onready var impact_sfx: AudioStreamPlayer3D = $ImpactSFX
@onready var heal_sfx: AudioStreamPlayer3D = $HealSFX
@onready var burn_sfx: AudioStreamPlayer3D = $BurnSFX

@export var fireball_scene: PackedScene
@export var fireball_speed: float = 20.0
@export var spawn_offset: float = 1.0

@onready var torch: Node3D = $Head/Camera3D/Torch
@onready var pause_menu: Control = $\"../UI/PauseMenu\"
@onready var fire_bar: TextureProgressBar = $\"../FireBar/FireBar\"
@onready var fire_vfx: GPUParticles2D = $\"../FireBar/Fire\"


var fire_bar_texture_height
var fire_vfx_y_offset

@export var grapple_range: float = 20.0
@export var enemy_group: String = \"enemies\"
var current_target: Node3D = null
@onready var grapple_icon: Sprite2D = $\"../UI/GrappleIcon\"
@export var icon_scale_near: float = 2 
@export var icon_scale_far: float = 0.75


func _ready():
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
	fire_bar_texture_height = (fire_bar.texture_progress.get_height())
	fire_vfx_y_offset = fire_vfx.position.y

#

func _unhandled_input(event):
	if event is InputEventMouseMotion && Input.mouse_mode == Input.MOUSE_MODE_CAPTURED: # Only move camera when mouse captured
		head.rotate_y(-event.relative.x * SENSITIVITY * pause_menu.mouse_sensitivity)
		camera.rotate_x(-event.relative.y * SENSITIVITY * pause_menu.mouse_sensitivity)
		camera.rotation.x = clamp(camera.rotation.x, deg_to_rad(-85), deg_to_rad(85))

func _physics_process(delta: float) -> void:
	# Restart
	if Input.is_action_just_pressed(\"Restart\"):
		get_tree().paused = false
		get_tree().reload_current_scene()
		
	# ================ SLAM  ================ 
	if Input.is_action_just_pressed(\"Slam\") and not is_on_floor() and current_state != states.SLAM:
		current_state = states.SLAM
		slam_sfx.play()
		velocity = Vector3(0,MAX_FALL_SPEED,0)

	# ================ DASH ================ 
	if Input.is_action_just_pressed(\"Dash\") and current_state != states.DASH and current_state != states.SLAM:
		start_dash()

	if current_state == states.DASH:
		dash_timer -= delta

		# Lock velocity to the dash direction
		velocity = dash_direction * DASH_SPEED

		# No gravity or movement while dashing
		move_and_slide()

		if dash_timer <= 0.0:
			current_state = states.GROUND if is_on_floor() else states.AIR

		return
	
	# ================ ATTACK ==================
	if Input.is_action_just_pressed(\"Attack\"):
		torch.attack(\"attack1\")
	
	if Input.is_action_pressed(\"E\"):	
		fire_bar.value += 1
		update_fire_vfx()
		
	if Input.is_action_pressed(\"Q\"):
		fire_bar.value -= 1
		update_fire_vfx()
	
	if Input.is_action_just_pressed(\"Fireball\"):
		shoot_fireball()
		

	# ================ MOVEMENT ================ 
	# Gravity + landing sfx
	if not is_on_floor():
		velocity += PLAYER_GRAVITY * delta
		velocity.y = max(velocity.y, MAX_FALL_SPEED)
		# Store the fastest downward speed
		fall_velocity = min(velocity.y, fall_velocity)
		if current_state != states.SLAM:
			current_state = states.AIR
	else:
		if current_state == states.AIR or current_state == states.SLAM:
			print(\"Fall speed:\", fall_velocity)
			var impact_volume = remap(abs(fall_velocity), LANDING_SFX_MIN_VELOCITY, LANDING_SFX_MAX_VELOCITY, LANDING_SFX_MIN_VOLUME, LANDING_SFX_MAX_VOLUME)
			landing_sfx.volume_db = clamp(impact_volume, LANDING_SFX_MIN_VOLUME, LANDING_SFX_MAX_VOLUME)
			landing_sfx.play()
			fall_velocity = 0.0
		current_state = states.GROUND

	# Jump
	if Input.is_action_just_pressed(\"Jump\") and is_on_floor():
		velocity.y = JUMP_VELOCITY
		jump_sfx.play()
	
	var input_dir := Input.get_vector(\"Left\", \"Right\", \"Forward\", \"Back\")
	var direction: Vector3 = (head.global_basis * Vector3(input_dir.x, 0.0, input_dir.y)).normalized()
	if current_state == states.SLAM:
		pass # no horizontal control while slamming
	elif current_state == states.GROUND:
		if direction != Vector3.ZERO:
			velocity.x = direction.x * speed
			velocity.z = direction.z * speed
		else:
			velocity.x = 0.0
			velocity.z = 0.0
	else:
		velocity.x = lerp(velocity.x, direction.x * speed, delta * AIR_CONTROL)
		velocity.z = lerp(velocity.z, direction.z * speed, delta * AIR_CONTROL)

	# Headbobbing
	t_bob += delta * velocity.length() * float(is_on_floor())
	camera.transform.origin = _headbob(t_bob)

	# FOV
	var velocity_clamped = clamp(velocity.length(), 0.5, SPRINT_SPEED * 2)
	var target_fov = BASE_FOV + FOV_SPEED_BOOST * velocity_clamped
	camera.fov = lerp(camera.fov, target_fov, delta * 8.0)
	
	#rope.scale = Vector3(1, 2 * global_position.distance_to(current_target.global_position), 1)
	#print(rope.scale)
	
	play_footsteps()
	move_and_slide()

func _process(_delta):
	current_target = find_best_target()
	update_grapple_icon()


func update_fire_vfx():
	var fire_percent = fire_bar.value / 100.0
	var mat = fire_vfx.process_material
	
	#fire_vfx.amount = int(lerp(5.0, 32.0, fire_percent))

	mat.scale_min = lerp(0.4, 0.8, fire_percent)
	mat.scale_max = lerp(0.4, 1.2, fire_percent)

	mat.initial_velocity_min = lerp(5.0, 30.0, fire_percent)
	mat.initial_velocity_max = lerp(10.0, 60.0, fire_percent)

	fire_vfx.position.y = (fire_bar_texture_height- fire_bar.value * (fire_bar_texture_height / 100.0) + fire_vfx_y_offset)

func _headbob(time) -> Vector3:
	var pos = Vector3.ZERO
	head_bobbing_x_position = cos(time * BOB_FREQ / 2) * BOB_AMP
	head_bobbing_y_position = sin(time * BOB_FREQ) * BOB_AMP

	pos.x = head_bobbing_x_position
	pos.y = head_bobbing_y_position
	return pos

func play_footsteps() -> void:
	if velocity != Vector3.ZERO:
		var bob_position_x = head_bobbing_x_position
		var bob_direction = sign(bob_position_x - last_bob_x_position)

		if bob_direction != 0 and bob_direction != last_bob_direction and last_bob_direction != 0:
			footsteps_sfx.play()

		last_bob_direction = bob_direction
		last_bob_x_position = bob_position_x
	else:
		last_bob_direction = 0
		last_bob_x_position = head_bobbing_x_position

func start_dash() -> void:
	dash_sfx.play()
	current_state = states.DASH
	dash_timer = DASH_DURATION

	var input_dir := Input.get_vector(\"Left\", \"Right\", \"Forward\", \"Back\")
	var direction: Vector3 = (head.global_basis * Vector3(input_dir.x, 0.0, input_dir.y)).normalized()

	# If there is no movement input, dash forward
	if direction == Vector3.ZERO:
		direction = -head.global_basis.z
		direction.y = 0.0
		direction = direction.normalized()

	dash_direction = direction
	velocity = dash_direction * DASH_SPEED

func find_best_target() -> Node3D:
	var viewport_size = get_viewport().get_visible_rect().size
	var screen_center = viewport_size / 2.0
	var cam = get_viewport().get_camera_3d()

	var best_target: Node3D = null
	var best_dist_sq: float = INF

	for enemy in get_tree().get_nodes_in_group(enemy_group):
		if not is_instance_valid(enemy):
			continue

		# range check in world space
		if global_position.distance_to(enemy.global_position) > grapple_range:
			continue

		# skip enemies behind the camera — unproject_position doesn't clip this itself
		if cam.is_position_behind(enemy.global_position):
			continue

		var screen_pos = cam.unproject_position(enemy.global_position)

		# optional: skip enemies that unprojected off-screen
		if screen_pos.x < 0 or screen_pos.x > viewport_size.x or screen_pos.y < 0 or screen_pos.y > viewport_size.y:
			continue

		var dist_sq = screen_pos.distance_squared_to(screen_center)

		if dist_sq < best_dist_sq:
			best_dist_sq = dist_sq
			best_target = enemy

	return best_target

func update_grapple_icon():
	if current_target and is_instance_valid(current_target):
		var cam = get_viewport().get_camera_3d()
		if cam.is_position_behind(current_target.global_position):
			grapple_icon.visible = false
			return
			
		grapple_icon.visible = true
		grapple_icon.global_position = cam.unproject_position(current_target.global_position)

		# scale based on distance
		var dist = global_position.distance_to(current_target.global_position)
		var dist_percent = clamp(dist / grapple_range, 0.0, 1.0)
		var target_scale = lerp(icon_scale_near, icon_scale_far, dist_percent)
		grapple_icon.scale = Vector2(target_scale, target_scale)
		
	else:
		grapple_icon.visible = false
	
func shoot_fireball() -> void:
	var fireball = fireball_scene.instantiate()
	get_tree().current_scene.add_child(fireball)

	# Direction the camera is facing (world space, forward is -Z in Godot)
	var direction: Vector3 = -camera.global_transform.basis.z

	# Spawn slightly in front of the camera so it doesn't collide with the player
	fireball.global_position = camera.global_position + direction * spawn_offset

	# Orient the fireball to face the direction it's traveling
	fireball.look_at(fireball.global_position + direction, Vector3.UP)

	# If your fireball script has a velocity/speed property, set it here
	if fireball.has_method(\"set_velocity\"):
		fireball.set_velocity(direction * fireball_speed)
	elif \"velocity\" in fireball:
		fireball.velocity = direction * fireball_speed

func take_damage(amount: float, source) -> void:
	if source == \"torch\":
		return # don't damage self
	if source != \"shard\":
		pause_menu.play_damage_visual()
		if not impact_sfx.playing:
			impact_sfx.play()
		if not hurt_sfx.playing:
			hurt_sfx.stream = hit_sounds[randi() % hit_sounds.size()]
			hurt_sfx.play()
	else:
		pause_menu.play_heal_visual()
		heal_sfx.play()
		burn_sfx.play()
	fire_bar.value -= amount
	update_fire_vfx()
"

