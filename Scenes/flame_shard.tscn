[sub_resource type="GDScript" id="GDScript_3ongi"]
resource_name = "Vacuum"
script/source = "extends Area3D

var parent: Area3D
var target_body: Node3D

@export var pull_strength: float = 5.0

func _ready() -> void:
	parent = get_parent_node_3d()

func _process(delta: float) -> void:
	if target_body != null:
		var direction := target_body.global_position - parent.global_position
		var distance := direction.length()

		parent.global_position += direction.normalized() * distance * delta

func _on_body_entered(body: Node3D) -> void:
	if body.name == \"Player\":
		target_body = body

func _on_body_exited(body: Node3D) -> void:
	if body == target_body:
		target_body = null
"

