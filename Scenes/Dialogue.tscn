[sub_resource type="GDScript" id="GDScript_1pivh"]
resource_name = "dialogue_controller"
script/source = "extends Control

@onready var dialogue_label: Label = $DialogueLabel
@onready var previous_label: Label = $PreviousLabel
@onready var next_label: Label = $NextLabel
@onready var skip_label: Label = $SkipLabel

@export var dialogue: Array[DialogueLine] = []
@export var cut_scene_image_path: NodePath
@export var fade_duration: float = 0.3
@export var load_tutorial_after: bool = false
@export var next_scene: PackedScene
@export var chars_per_second: float = 40.0
@export var enable_skip_prompt: bool = false

@export_group(\"Typing SFX\")
@export var typing_sfx: AudioStream
@export var pitch_variance: float = 0.15  # +/- 15% pitch randomization
@export var skip_sfx_on_whitespace: bool = true
@export var sfx_pool_size: int = 6  # how many overlapping blips can play at once
@export var sfx_every_n_chars: int = 4  # only play a blip every Nth typed character
@export_range(0.0, 1.0, 0.01) var sfx_volume: float = 1.0  # linear volume, shows as a slider in the Inspector

var cut_scene_image: TextureRect = null
var index: int = 0
var fade_tween: Tween = null
var type_tween: Tween = null
var lifetime_timer: SceneTreeTimer = null
var text_fade_tween: Tween = null
var is_typing: bool = false
var full_text: String = \"\"
var is_active: bool = false
var has_finished: bool = false
var last_visible_count: int = 0

var _sfx_pool: Array[AudioStreamPlayer] = []
var _sfx_pool_index: int = 0
var _sfx_char_counter: int = 0

func _ready() -> void:
	add_to_group(\"dialogue_controller\")
	skip_label.visible = enable_skip_prompt

	_build_sfx_pool()

	if cut_scene_image_path != NodePath(\"\"):
		cut_scene_image = get_node_or_null(cut_scene_image_path) as TextureRect
	if dialogue.is_empty():
		push_warning(\"Dialogue array is empty — nothing to display.\")
		visible = false
		return
	display_dialogue()

func _build_sfx_pool() -> void:
	for i in range(sfx_pool_size):
		var p := AudioStreamPlayer.new()
		add_child(p)
		_sfx_pool.append(p)

func _process(_delta: float) -> void:
	if dialogue.is_empty():
		return

	if Input.is_action_just_pressed(\"Skip\"):
		_start_next_scene()

	if Input.is_action_just_pressed(\"E\"):
		if is_typing:
			_skip_typing()
		elif index < dialogue.size() - 1:
			index += 1
			display_dialogue()
		elif load_tutorial_after:
			_start_next_scene()
		else:
			_end_dialogue()

	if Input.is_action_just_pressed(\"Q\"):
		if index > 0:
			index -= 1
			display_dialogue()

func display_dialogue() -> void:
	_cancel_lifetime_timer()

	var line := dialogue[index]
	full_text = line.text

	if text_fade_tween != null and text_fade_tween.is_valid():
		text_fade_tween.kill()
	dialogue_label.modulate.a = 1.0
	previous_label.modulate.a = 1.0
	next_label.modulate.a = 1.0

	_start_typing(full_text)

	previous_label.visible = index > 0

	if index < dialogue.size() - 1:
		next_label.text = \"Next: E\"
		next_label.visible = true
	elif load_tutorial_after:
		next_label.text = \"Start: E\"
		next_label.visible = true
	else:
		next_label.text = \"Close: E\"
		next_label.visible = true

	if cut_scene_image != null:
		cut_scene_image.visible = line.show_cutscene
		var effective_image := _get_effective_image(index)
		if effective_image != null and effective_image != cut_scene_image.texture:
			_fade_to_texture(effective_image)

func _start_typing(text: String) -> void:
	if type_tween != null and type_tween.is_valid():
		type_tween.kill()

	dialogue_label.text = \"\"
	is_typing = true
	last_visible_count = 0
	_sfx_char_counter = 0

	var duration := text.length() / chars_per_second
	type_tween = create_tween()
	type_tween.tween_method(_set_visible_chars, 0, text.length(), duration)
	type_tween.tween_callback(_on_typing_finished)

func _set_visible_chars(count: int) -> void:
	dialogue_label.text = full_text.substr(0, count)

	if count > last_visible_count:
		for i in range(last_visible_count, count):
			var ch := full_text[i]
			if skip_sfx_on_whitespace and ch.strip_edges() == \"\":
				continue
			_play_typing_sfx()
	last_visible_count = count

func _play_typing_sfx() -> void:
	_sfx_char_counter += 1
	if sfx_every_n_chars > 1 and _sfx_char_counter % sfx_every_n_chars != 0:
		return

	if typing_sfx == null or _sfx_pool.is_empty():
		return

	var p := _sfx_pool[_sfx_pool_index]
	_sfx_pool_index = (_sfx_pool_index + 1) % _sfx_pool.size()

	p.stream = typing_sfx
	p.pitch_scale = 1.0 + randf_range(-pitch_variance, pitch_variance)
	p.volume_db = linear_to_db(clampf(sfx_volume, 0.0, 1.0))
	p.play()

func _skip_typing() -> void:
	if type_tween != null and type_tween.is_valid():
		type_tween.kill()
	dialogue_label.text = full_text
	last_visible_count = full_text.length()
	is_typing = false
	_on_typing_finished()

func _on_typing_finished() -> void:
	is_typing = false
	var line := dialogue[index]
	if line.display_lifetime > 0.0:
		lifetime_timer = get_tree().create_timer(line.display_lifetime)
		lifetime_timer.timeout.connect(_on_lifetime_expired.bind(index))

func _on_lifetime_expired(expired_index: int) -> void:
	if expired_index != index:
		return

	var on_finished: Callable = _end_dialogue
	if index < dialogue.size() - 1:
		on_finished = _advance_from_lifetime

	text_fade_tween = create_tween()
	text_fade_tween.set_parallel(true)
	text_fade_tween.tween_property(dialogue_label, \"modulate:a\", 0.0, fade_duration)
	text_fade_tween.tween_property(previous_label, \"modulate:a\", 0.0, fade_duration)
	text_fade_tween.tween_property(next_label, \"modulate:a\", 0.0, fade_duration)
	text_fade_tween.chain().tween_callback(on_finished)

func _advance_from_lifetime() -> void:
	index += 1
	display_dialogue()

func _cancel_lifetime_timer() -> void:
	if lifetime_timer != null and lifetime_timer.timeout.is_connected(_on_lifetime_expired):
		lifetime_timer.timeout.disconnect(_on_lifetime_expired)
	lifetime_timer = null

func _get_effective_image(from_index: int) -> Texture2D:
	for i in range(from_index, -1, -1):
		if dialogue[i].image != null:
			return dialogue[i].image
	return null

func _fade_to_texture(new_texture: Texture2D) -> void:
	if fade_tween != null and fade_tween.is_valid():
		fade_tween.kill()

	fade_tween = create_tween()
	fade_tween.tween_property(cut_scene_image, \"modulate:a\", 0.0, fade_duration / 2.0)
	fade_tween.tween_callback(func(): cut_scene_image.texture = new_texture)
	fade_tween.tween_property(cut_scene_image, \"modulate:a\", 1.0, fade_duration / 2.0)

func _start_next_scene() -> void:
	if next_scene != null:
		has_finished = true
		is_active = false
		get_tree().change_scene_to_packed(next_scene)
	else:
		push_warning(\"load_tutorial_after is true but next_scene is not assigned in the Inspector.\")

func _end_dialogue() -> void:
	has_finished = true
	is_active = false
	visible = false

func force_close() -> void:
	is_active = false
	visible = false
	if type_tween != null and type_tween.is_valid():
		type_tween.kill()
	_cancel_lifetime_timer()

func start_dialogue(lines: Array[DialogueLine]) -> void:
	var same_conversation := lines == dialogue

	if is_active and same_conversation:
		return  # already showing this exact conversation, ignore duplicate trigger fires

	if not same_conversation or has_finished:
		# Fresh start: new conversation, or this one was already completed before
		_cancel_lifetime_timer()
		if type_tween != null and type_tween.is_valid():
			type_tween.kill()
		if text_fade_tween != null and text_fade_tween.is_valid():
			text_fade_tween.kill()

		dialogue_label.modulate.a = 1.0
		previous_label.modulate.a = 1.0
		next_label.modulate.a = 1.0

		dialogue = lines
		index = 0
		has_finished = false
		is_active = true
		visible = true
		display_dialogue()
	else:
		# Left mid-conversation last time — just reappear exactly as it was
		is_active = true
		visible = true

func set_type_speed(value: float):
	chars_per_second = value
	if value == 0:
		chars_per_second = 9999999
"

