[gd_scene format=3 uid="uid://ck8skyps5hcx1"]

[sub_resource type="GDScript" id="GDScript_x0eg5"]
resource_name = "LoadLevel"
script/source = "extends Area3D

@export var SceneName: String = \"\"

func _on_body_entered(body: Node3D) -> void:
	if body.name == \"Player\":
		if SceneName == \"\":
			push_warning(\"SceneName is empty — nothing to load.\")
			return
		var err := get_tree().change_scene_to_file(SceneName)
		if err != OK:
			push_error(\"Failed to change scene to '%s' (error %d)\" % [SceneName, err])
"

