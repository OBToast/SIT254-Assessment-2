[sub_resource type="GDScript" id="GDScript_10okh"]
script/source = "extends StaticBody3D

@onready var death_particles: GPUParticles3D = $\"../DeathParticles\"
@onready var break_sfx: AudioStreamPlayer3D = $BreakSFX
@onready var slam_detector: Area3D = $\"../SlamDetector\"
@onready var collision_shape_3d: CollisionShape3D = $CollisionShape3D
@onready var plank_1: MeshInstance3D = $plank1
@onready var plank_2: MeshInstance3D = $plank2
@onready var plank_3: MeshInstance3D = $plank3

var is_broken: bool = false


func _ready() -> void:
	slam_detector.body_entered.connect(_on_slam_detector_body_entered)


func _on_slam_detector_body_entered(body: Node3D) -> void:
	if is_broken:
		return
	if body.name != \"Player\":
		return
	if body.current_state != body.states.SLAM:
		return
	break_plank()


func break_plank() -> void:
	is_broken = true

	death_particles.global_position = global_position
	death_particles.restart()
	death_particles.emitting = true

	if break_sfx:
		var parent := get_parent()
		break_sfx.reparent(parent)
		break_sfx.global_position = global_position
		break_sfx.play()
		break_sfx.finished.connect(break_sfx.queue_free)

	collision_shape_3d.disabled = true
	plank_1.hide()
	plank_2.hide()
	plank_3.hide()

	queue_free()
"

