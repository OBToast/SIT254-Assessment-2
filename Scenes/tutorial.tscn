[sub_resource type="GDScript" id="GDScript_d33ey"]
script/source = "extends Area3D

@export var player_path: NodePath
@onready var player: Node3D = get_node(player_path)
@onready var lantern: MeshInstance3D = $Lantern
@onready var omni_light_3d: OmniLight3D = $Lantern/OmniLight3D
@onready var fire_bar: Node2D = $\"../FireBar\"
@onready var gate_collider: CollisionShape3D = $\"../BluestonewallGate/GateCollider/GateCollider\"
@onready var rightgate: Node3D = $\"../BluestonewallGate/Gate/Right/RIGHTGATE\"
@onready var leftgate: Node3D = $\"../BluestonewallGate/Gate/Left/LEFTGATE\"
@onready var gpu_particles_3d: GPUParticles3D = $\"../GPUParticles3D\"


func _ready() -> void:
	fire_bar.visible = false
	body_entered.connect(_on_body_entered)
	player.disable_torch()


func _on_body_entered(body: Node3D) -> void:
	if body.name != \"Player\":
		return

	fire_bar.visible = true
	player.enable_torch()
	lantern.visible = false
	omni_light_3d.visible = false
	gate_collider.disabled = true

	leftgate.rotation_degrees.y = 140
	rightgate.rotation_degrees.y = -120
	gpu_particles_3d.emitting = false
	player.is_burning = true
"

