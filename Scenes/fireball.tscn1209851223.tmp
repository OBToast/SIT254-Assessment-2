[ext_resource type="Texture2D" uid="uid://bqdibs8fridpa" path="res://Assets/Textures/the-image-is-of-a-white-smoke-cloud-with-a-lot-of-white-smoke-png.webp" id="1_xi7wk"]

[sub_resource type="GDScript" id="GDScript_xi7wk"]
resource_name = "fireball"
script/source = "extends Area3D

@export var speed: float = 20.0
@export var damage: float = 10.0
@export var lifetime: float = 5.0
@export var light_fade_time: float = 0.5  # much faster than the particle lifetime

@onready var explosion: GPUParticles3D = $Explosion
@onready var omni_light_3d: OmniLight3D = $OmniLight3D

var velocity: Vector3 = Vector3.ZERO

func _ready() -> void:
	await get_tree().create_timer(lifetime).timeout
	if is_instance_valid(self):
		queue_free()

func _physics_process(delta: float) -> void:
	global_position += velocity * delta

func _on_body_entered(body: Node3D) -> void:
	if body.has_method(\"take_damage\"):
		body.take_damage(damage)
	_explode()

func _on_area_entered(area: Area3D) -> void:
	if area.has_method(\"take_damage\"):
		area.take_damage(damage)
	_explode()

func _explode() -> void:
	velocity = Vector3.ZERO
	set_deferred(\"monitoring\", false)
	set_deferred(\"monitorable\", false)

	# Detach the particles so they survive after the fireball is freed
	explosion.reparent(get_tree().current_scene)
	explosion.emitting = true

	# Detach the light so it survives after the fireball is freed
	omni_light_3d.reparent(get_tree().current_scene)

	var tween := omni_light_3d.create_tween()
	tween.tween_property(omni_light_3d, \"light_energy\", 0.0, light_fade_time)
	tween.finished.connect(func():
		if is_instance_valid(omni_light_3d):
			omni_light_3d.queue_free()
	)

	queue_free()

	await get_tree().create_timer(explosion.lifetime).timeout
	if is_instance_valid(explosion):
		explosion.queue_free()
"

